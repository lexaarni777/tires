# Local development template. Copy to backend/.env and replace placeholders.
# Never commit backend/.env or use these placeholder secrets in production.
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

DATABASE_URL=postgresql://msktires:CHANGE_ME@127.0.0.1:5432/msktires
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_LOCAL_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional integrations. Fill these only when the corresponding feature is used.
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
