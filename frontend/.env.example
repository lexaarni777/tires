# Local Next.js settings. Copy to frontend/.env.
# NEXT_PUBLIC_* values are visible in the browser; never put secrets here.
# Backend API base URL (must include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Public site URL used for canonical URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
