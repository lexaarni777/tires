# Copy to /etc/msktires/frontend.env and replace example.com.
# NEXT_PUBLIC_* values are embedded into the browser bundle during `next build`.
NEXT_PUBLIC_API_URL=https://example.com/api
NEXT_PUBLIC_SITE_URL=https://example.com

# Used only by deployment smoke checks.
PUBLIC_URL=https://example.com
# Set these to real, stable public resources before the first deployment.
SMOKE_PRODUCT_ARTICLE=
SMOKE_UPLOAD_PATH=
