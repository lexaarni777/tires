# Copy to /etc/msktires/backend.env and replace every placeholder.
# Never commit the real file.
CLIENT_URL=https://example.com
DATABASE_URL=postgresql://msktires:CHANGE_ME@127.0.0.1:5432/msktires
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional integrations. Leave values empty only when the feature is disabled.
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
