[Unit]
Description=MSKTires Next.js frontend
After=network-online.target msktires-backend.service
Wants=network-online.target

[Service]
Type=simple
User=msktires
Group=msktires
WorkingDirectory=/opt/msktires/current/frontend
Environment=NODE_ENV=production
EnvironmentFile=/etc/msktires/frontend.env
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
